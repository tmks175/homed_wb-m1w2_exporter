# MQTT
MQTT_BROKER=<ip адрес брокера>
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=homed

# Exporter
HTTP_PORT=8010
POLL_INTERVAL_SEC=300

# Возраст кэша в сек. (после этого - данные считаются устаревшими)
MAX_CACHE_AGE_SEC=600

# WB sensors (номер и каналы - см. скриншот в images)
DEVICE=1.50
SENSORS=1,2

# Other options
CACHE_DIR=/opt/modbus-wb/tmp-temp
LOG_FILE=/opt/modbus-wb/prom_exporter.log

# Log level (INFO, WARNING, ERROR)
LOG_LEVEL=INFO